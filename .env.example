DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_forge?schema=public"
# Store backend: prisma (when DATABASE_URL is reachable) | file (durable disk .data/ai-forge-store.json) | memory (isolated tests)
# AI_FORGE_STORE=file

# Fail-Closed Authentication & Cryptographic Master Key (REM-01, REM-02, REM-03)
AI_FORGE_REQUIRE_AUTH="1"
AUTH_SECRET="replace-with-32-byte-minimum-random-string"
NEXTAUTH_SECRET="replace-with-32-byte-minimum-random-string"
AI_FORGE_MASTER_ENCRYPTION_KEY="replace-with-32-byte-aes256gcm-master-key"
NEXTAUTH_URL="http://localhost:3000"

# Seeded Workspace Account Passwords (optional — overrides default local passwords via scrypt KDF):
# AI_FORGE_ADMIN_PASSWORD=
# AI_FORGE_OPERATOR_PASSWORD=
# AI_FORGE_AUDITOR_PASSWORD=
# AI_FORGE_VIEWER_PASSWORD=

# Stripe SaaS Subscription Billing & Signed Webhook (HMAC-SHA256):
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_ENTERPRISE=price_...

# Live LLM Provider Keys (optional — automatically enables LiveLlmModelAdapter in real-integration mode):
# NVIDIA_API_KEY=nvapi-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIza...
# AI_FORGE_MODEL=meta/llama-3.3-70b-instruct

# Live GitHub REST API Token (optional for public repos, required for private repos & higher rate limits):
# Can also be configured per-tenant inside the AES-256-GCM BYOK Vault at /settings
# GITHUB_TOKEN=ghp_...

# Asymmetric Ed25519 Signing Keypair (optional — auto-generated and persisted in .data/keys/ed25519-keypair.json if omitted):
# AI_FORGE_ED25519_PRIVATE_KEY_PEM=
# AI_FORGE_ED25519_PUBLIC_KEY_PEM=

# Enterprise OIDC SSO:
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
